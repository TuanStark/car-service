# Application
NODE_ENV=development
APP_NAME=autora-api
APP_PORT=4000
APP_URL=http://localhost:4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost:4100

# PostgreSQL
DATABASE_URL=postgresql://autora:autora_dev_password@localhost:5433/autora_db?schema=public&connection_limit=20&pool_timeout=15
DATABASE_SLOW_QUERY_MS=200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=autora_redis_dev
REDIS_DB=0

# Security & JWT
JWT_ACCESS_SECRET=replace_with_at_least_32_chars_access_secret_key_for_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_at_least_32_chars_refresh_secret_key_for_dev
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_at_least_32_chars_cookie_signing_secret
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Rate Limiting & Idempotency
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
IDEMPOTENCY_TTL_SECONDS=86400

# Observability
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Mail (Local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="AUTORA Car Service <no-reply@autora.vn>"

# Swagger
SWAGGER_ENABLED=true
