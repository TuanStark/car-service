# Server
NODE_ENV=development
PORT=4100
CORS_ORIGINS=http://localhost:3000,http://localhost:3030

# Database & Redis (matches docker-compose.yml)
DATABASE_URL="postgresql://autora:autora_dev_secret@localhost:5433/autora_agent?schema=public"
REDIS_URL="redis://localhost:6380"
STORAGE_DRIVER=memory # "memory" | "prisma"

# LLM Strategy:
# - production: OpenRouter (primary)
# - development: auto (Gemini API -> AGY CLI fallback -> Local Deterministic Advisor)
LLM_PROVIDER=auto # "auto" | "openrouter" | "gemini" | "agy" | "mock"

# OpenRouter (Production)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini API (Development)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AGY CLI Fallback (Development when Gemini API quota is exhausted)
AGY_CLI_ENABLED=true
AGY_CLI_BIN=agy
AGY_CLI_TIMEOUT_MS=25000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

